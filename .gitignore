# ── Rust build artifacts ────────────────────────────────────────────────────
target/
circuit/target/

# Cargo.lock is kept for binaries (service, input-gen, circuit) to ensure
# reproducible builds; omit this line if you want to ignore it.
# Cargo.lock

# ── Circuit ELF ─────────────────────────────────────────────────────────────
# The pre-built ELF is tracked at circuit/elf/circuit.elf so other contributors
# can run the service without needing the +zisk toolchain.
# circuit/elf/circuit.elf  ← intentionally tracked

# ── Generated / runtime data ─────────────────────────────────────────────────
data/
go-sdk/data/
proof_output/

# ── Proving keys ─────────────────────────────────────────────────────────────
# Too large (~37 GB) to track. The Docker-driven `make keys` target
# downloads them into ./zisk-keys; bare-host installs land in ~/.zisk.
zisk-keys/
provingKey/
*.consttree
*.consttree_gpu
*.verkey.bin

# ── Powers of Tau ceremony files ─────────────────────────────────────────────
# Large binary files (97MB–288MB); download separately via snarkjs.
*.ptau

# ── Docker / local environment ───────────────────────────────────────────────
# .env holds COMPOSE_PROFILES and other local overrides; not committed so each
# developer can choose their own profile (cuda / cpu) without affecting others.
.env
.env.local.nodocker
*.log

# ── Go test binaries ─────────────────────────────────────────────────────────
go-sdk/tests/*.test

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ── Internal planning ────────────────────────────────────────────────────────
plan.md

# ── Claude Code session state ────────────────────────────────────────────────
.claude/

# ── Reference checkouts / prototypes (not part of this repo) ────────────────
davinci-node/
recursion-experiment/

# ── Benchmark artifacts ──────────────────────────────────────────────────────
# Logs, generated reports and the cached pre-generated ballots.
benchmark/results/
benchmark/cache/
