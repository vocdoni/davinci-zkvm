# ── Stage 1: Install official ZisK release binaries with CUDA/GPU support ────
# Uses CUDA 12.8 — required for RTX 5000 series (Blackwell sm_120, PTX 8.7)
# Driver 570+ needed; CUDA 13.x is NOT compatible with driver 570.
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04 AS zisk-release

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tar \
    libgmp-dev \
    libssl3 \
    libgomp1 \
    libsodium23 \
    libopenmpi3 \
    openmpi-bin \
    openmpi-common \
    libomp5 \
    && rm -rf /var/lib/apt/lists/*

ARG ZISK_VERSION=v0.17.0
ARG ZISK_RELEASE_URL=https://github.com/0xPolygonHermez/zisk/releases/download/${ZISK_VERSION}/cargo_zisk_linux_amd64.tar.gz

RUN mkdir -p /opt/zisk && \
    curl -L --fail -o /tmp/cargo_zisk_linux_amd64.tar.gz "${ZISK_RELEASE_URL}" && \
    tar -xzf /tmp/cargo_zisk_linux_amd64.tar.gz -C /opt/zisk && \
    mv /opt/zisk/bin/cargo-zisk-gpu /opt/zisk/bin/cargo-zisk && \
    mv /opt/zisk/bin/zisk-worker-gpu /opt/zisk/bin/zisk-worker && \
    rm -f /opt/zisk/bin/cargo-zisk-cpu /opt/zisk/bin/zisk-worker-cpu /tmp/cargo_zisk_linux_amd64.tar.gz && \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64 /opt/zisk/bin/cargo-zisk --version | grep -F '[gpu]'

# ── Stage 2: Build the Rust service ───────────────────────────────────────────
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04 AS service-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY input-gen/Cargo.toml input-gen/Cargo.toml
COPY service/Cargo.toml service/Cargo.toml

RUN mkdir -p input-gen/src input-gen/src/bin service/src && \
    echo 'pub fn placeholder() {}' > input-gen/src/lib.rs && \
    echo 'fn main() {}' > input-gen/src/bin/gen-input.rs && \
    echo 'fn main() {}' > service/src/main.rs

RUN cargo build --release -p davinci-zkvm-service -p davinci-zkvm-input-gen 2>&1 || true
RUN rm -rf input-gen/src service/src

COPY input-gen/src input-gen/src
COPY service/src service/src

# Invalidate fingerprints so cargo rebuilds the real crates
RUN find target/release/.fingerprint -maxdepth 1 -name "davinci*" -exec rm -rf {} + 2>/dev/null || true

RUN cargo build --release -p davinci-zkvm-service -p davinci-zkvm-input-gen

# ── Stage 3: CUDA runtime image ───────────────────────────────────────────────
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    make \
    gcc \
    g++ \
    binutils \
    libgmp-dev \
    libssl3 \
    libgomp1 \
    libsodium23 \
    libopenmpi3 \
    openmpi-bin \
    openmpi-common \
    libomp5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy official GPU-enabled cargo-zisk and runtime helpers required by v0.17.0 ROM setup
RUN mkdir -p /root/.zisk/bin /root/.zisk/zisk
COPY --from=zisk-release /opt/zisk/bin/cargo-zisk /usr/local/bin/cargo-zisk
COPY --from=zisk-release /opt/zisk/bin/ziskemu /usr/local/bin/ziskemu
COPY --from=zisk-release /opt/zisk/bin/riscv2zisk /usr/local/bin/riscv2zisk
COPY --from=zisk-release /opt/zisk/bin/zisk-worker /usr/local/bin/zisk-worker
COPY --from=zisk-release /opt/zisk/bin/zisk-coordinator /usr/local/bin/zisk-coordinator
COPY --from=zisk-release /opt/zisk/bin/libziskclib.a /root/.zisk/bin/libziskclib.a
COPY --from=zisk-release /opt/zisk/zisk/emulator-asm /root/.zisk/zisk/emulator-asm
COPY --from=zisk-release /opt/zisk/zisk/lib-c /root/.zisk/zisk/lib-c

# Copy service binary
COPY --from=service-builder /build/target/release/davinci-zkvm /app/davinci-zkvm

# Copy pre-built circuit ELF
COPY circuit/elf/circuit.elf /app/circuit.elf

ENV LISTEN_ADDR=0.0.0.0:8080
ENV PROVING_KEY_PATH=/proving-key
ENV CIRCUIT_ELF_PATH=/app/circuit.elf
ENV CARGO_ZISK_BIN=/usr/local/bin/cargo-zisk
ENV PROOF_OUTPUT_DIR=/proofs
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
# Restrict OpenMPI to loopback/shared-memory transport only — prevents any
# CUDA-aware MPI transport from touching the CUDA context and destroying it.
ENV OMPI_MCA_btl=vader,self
ENV OMPI_MCA_pml=ob1
ENV OMPI_MCA_opal_cuda_support=0
ENV OMPI_MCA_btl_smcuda_use_cuda_ipc=0
# Allow OpenMPI to run as root (required in Docker containers)
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# Check-setup entrypoint: validate proving key, warm up CUDA, then start service.
# v0.17.0: GPU is auto-detected; constant trees are built on-demand during prove.
COPY <<'EOF' /app/entrypoint.sh
#!/bin/bash
set -e

# GPU warmup: run check-setup to initialize CUDA twiddle factors
# and force the NVIDIA driver to create a stable device context before serving.
# This prevents the "context is destroyed" cold-start race on the first prove call.
echo "=== GPU warmup: initializing CUDA context ==="
/usr/local/bin/cargo-zisk check-setup --proving-key "${PROVING_KEY_PATH}" 2>/dev/null || true

exec /app/davinci-zkvm "$@"
EOF
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
