# ── Stage 1: Download ZisK prebuilt GPU binary ───────────────────────────────
# Uses the official prebuilt cargo-zisk-gpu for linux/amd64 from the ZisK release.
# This avoids a multi-hour CUDA source build during docker image construction.
FROM ubuntu:24.04 AS zisk-downloader

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG ZISK_VERSION=v0.18.0

# Download and extract the prebuilt ZisK GPU bundle for linux/amd64.
# The tarball layout: ./bin/{cargo-zisk-gpu,cargo-zisk-cpu,...} + ./zisk/emulator-asm/...
RUN curl -fL \
    "https://github.com/0xPolygonHermez/zisk/releases/download/${ZISK_VERSION}/cargo_zisk_linux_amd64.tar.gz" \
    -o /tmp/cargo_zisk.tar.gz && \
    mkdir -p /opt/zisk && \
    tar --ignore-zeros -xzf /tmp/cargo_zisk.tar.gz -C /opt/zisk && \
    rm /tmp/cargo_zisk.tar.gz && \
    # Symlink cargo-zisk -> cargo-zisk-gpu for backward compatibility
    ln -sf /opt/zisk/bin/cargo-zisk-gpu /opt/zisk/bin/cargo-zisk

# ── Stage 2: Build the Rust service ───────────────────────────────────────────
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04 AS service-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY input-gen/Cargo.toml input-gen/Cargo.toml
COPY service/Cargo.toml service/Cargo.toml

RUN mkdir -p input-gen/src input-gen/src/bin service/src && \
    echo 'pub fn placeholder() {}' > input-gen/src/lib.rs && \
    echo 'fn main() {}' > input-gen/src/bin/gen-input.rs && \
    echo 'fn main() {}' > service/src/main.rs

RUN cargo build --release -p davinci-zkvm-service -p davinci-zkvm-input-gen 2>&1 || true
RUN rm -rf input-gen/src service/src

COPY input-gen/src input-gen/src
COPY service/src service/src

# Invalidate fingerprints so cargo rebuilds the real crates
RUN find target/release/.fingerprint -maxdepth 1 -name "davinci*" -exec rm -rf {} + 2>/dev/null || true

RUN cargo build --release -p davinci-zkvm-service -p davinci-zkvm-input-gen

# ── Stage 3: CUDA runtime image ───────────────────────────────────────────────
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
    libgomp1 \
    libsodium23 \
    libopenmpi3 \
    openmpi-bin \
    openmpi-common \
    libomp5-18 \
    build-essential \
    nasm \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Ensure ~/.zisk/bin exists for cargo-zisk support files
RUN mkdir -p /root/.zisk/bin

# Copy ZisK GPU binary and supporting files from the downloader stage.
# v0.18.0 ships cargo-zisk-gpu; cargo-zisk symlink is set in the downloader stage.
COPY --from=zisk-downloader /opt/zisk/bin/cargo-zisk-gpu /usr/local/bin/cargo-zisk-gpu
COPY --from=zisk-downloader /opt/zisk/bin/cargo-zisk /usr/local/bin/cargo-zisk
COPY --from=zisk-downloader /opt/zisk/bin/ziskemu /usr/local/bin/ziskemu
# riscv2zisk converts RISC-V ELF to ZisK assembly during ROM setup (first prove)
COPY --from=zisk-downloader /opt/zisk/bin/riscv2zisk /usr/local/bin/riscv2zisk
# libziskclib.a is required at ~/.zisk/bin/ by cargo-zisk prove (pre-built C library)
COPY --from=zisk-downloader /opt/zisk/bin/libziskclib.a /root/.zisk/bin/libziskclib.a
# zisk support files needed by check-setup and proving (emulator-asm, lib-c)
COPY --from=zisk-downloader /opt/zisk/zisk /root/.zisk/zisk

# Copy service binary
COPY --from=service-builder /build/target/release/davinci-zkvm /app/davinci-zkvm

# Copy pre-built circuit ELFs
COPY circuit/elf/circuit.elf /app/circuit.elf
COPY circuit-aggregator/elf/aggregator.elf /app/aggregator.elf

ENV LISTEN_ADDR=0.0.0.0:8080
ENV PROVING_KEY_PATH=/proving-key
ENV PROVING_KEY_PLONK_PATH=/proving-key-plonk
ENV CIRCUIT_ELF_PATH=/app/circuit.elf
ENV AGGREGATOR_ELF_PATH=/app/aggregator.elf
ENV CARGO_ZISK_BIN=/usr/local/bin/cargo-zisk
ENV PROOF_OUTPUT_DIR=/proofs
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
# Restrict OpenMPI to loopback/shared-memory transport only — prevents any
# CUDA-aware MPI transport from touching the CUDA context and destroying it.
ENV OMPI_MCA_btl=vader,self
ENV OMPI_MCA_pml=ob1
ENV OMPI_MCA_opal_cuda_support=0
ENV OMPI_MCA_btl_smcuda_use_cuda_ipc=0
# Allow OpenMPI to run as root (required in Docker containers)
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# Install python3 and binutils so the entrypoint can patch final.so's
# executable-stack flag (see below) using stock tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 binutils \
    && rm -rf /var/lib/apt/lists/*

# Entrypoint:
#   1. Patch the PLONK key's final.so to drop the executable-stack flag that
#      modern Linux refuses to grant at dlopen time. Idempotent.
#   2. Build STARK + PLONK constant trees if missing.
#   3. Warm up the CUDA context so the first prove doesn't pay the
#      cold-start penalty.
#   4. Start the service.
COPY <<'EOF' /app/entrypoint.sh
#!/bin/bash
set -e

FINAL_SO="${PROVING_KEY_PLONK_PATH}/final/final.so"
if [ -f "${FINAL_SO}" ] && readelf -lW "${FINAL_SO}" 2>/dev/null | grep -q "GNU_STACK.* RWE"; then
    echo "=== Patching ${FINAL_SO} to drop executable-stack flag ==="
    if ! python3 - "${FINAL_SO}" <<'PYEOF' 2>&1
import struct, sys
path = sys.argv[1]
with open(path, "r+b") as f:
    data = f.read()
    e_phoff = struct.unpack("<Q", data[32:40])[0]
    e_phentsize = struct.unpack("<H", data[54:56])[0]
    e_phnum = struct.unpack("<H", data[56:58])[0]
    PT_GNU_STACK = 0x6474e551
    for i in range(e_phnum):
        off = e_phoff + i * e_phentsize
        p_type, p_flags = struct.unpack("<II", data[off:off+8])
        if p_type == PT_GNU_STACK:
            f.seek(off + 4)
            f.write(struct.pack("<I", p_flags & ~0x1))
            break
PYEOF
    then
        # Read-only mount? Warn and continue — the service will surface
        # the actual error on the first prove.
        echo "  (could not patch; the proving-key mount may be read-only)"
    fi
fi

STARK_TREE="${PROVING_KEY_PATH}/zisk/Zisk/airs/ArithEq/compressor/compressor.consttree_gpu"
if [ ! -f "${STARK_TREE}" ]; then
    echo "=== Building STARK constant trees (one-time, ~10 min) ==="
    /usr/local/bin/cargo-zisk check-setup \
        --proving-key "${PROVING_KEY_PATH}" \
        --gpu
fi

PLONK_TREE="${PROVING_KEY_PLONK_PATH}/recursivef/recursivef.consttree_gpu"
if [ -d "${PROVING_KEY_PLONK_PATH}" ] && [ ! -f "${PLONK_TREE}" ]; then
    echo "=== Building PLONK constant trees (one-time, ~30 s) ==="
    /usr/local/bin/cargo-zisk check-setup \
        --proving-key "${PROVING_KEY_PATH}" \
        --proving-key-plonk "${PROVING_KEY_PLONK_PATH}" \
        --plonk --gpu
fi

echo "=== GPU warmup: initializing CUDA context ==="
/usr/local/bin/cargo-zisk check-setup --proving-key "${PROVING_KEY_PATH}" --gpu 2>/dev/null || true

exec /app/davinci-zkvm "$@"
EOF
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
