# ── Stage 1: Build cargo-zisk with CUDA GPU support ──────────────────────────
# Uses CUDA 12.8 — required for RTX 5000 series (Blackwell sm_120, PTX 8.7)
# Driver 570+ needed; CUDA 13.x is NOT compatible with driver 570
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04 AS cuda-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    cmake \
    libgmp-dev \
    nlohmann-json3-dev \
    libsodium-dev \
    libopenmpi-dev \
    nasm \
    libclang-dev \
    clang \
    protobuf-compiler \
    libprotobuf-dev \
    libomp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y --default-toolchain 1.85.0 --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

ARG ZISK_VERSION=v0.16.0

# Clone ZisK source at the pinned version and build with GPU support
RUN git clone --depth 1 --branch ${ZISK_VERSION} \
    https://github.com/0xPolygonHermez/zisk.git /src/zisk

WORKDIR /src/zisk

# Use CUDA 12.8 nvcc for building libstarksgpu.a
ENV PATH="/usr/local/cuda-12.8/bin:$PATH"

# Build libstarksgpu.a then cargo-zisk with GPU support
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    bash -c 'set -euo pipefail; cargo build --release --features gpu 2>&1 | tee /tmp/build.log'

RUN /src/zisk/target/release/cargo-zisk sdk install-toolchain

# ── Stage 2: Build the Rust service (with ballot-aggregation) ─────────────────
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04 AS service-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y --default-toolchain 1.93.1 --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

# -- Copy davinci-stark source (path dep of recursion-aggregator at ../../) --
WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs ./
COPY src src
COPY vendor vendor

# -- Copy Plonky3-recursion (path deps of recursion-aggregator) --
WORKDIR /build/davinci-zkvm
COPY davinci-zkvm/Plonky3-recursion/Cargo.toml Plonky3-recursion/Cargo.toml
COPY davinci-zkvm/Plonky3-recursion/circuit Plonky3-recursion/circuit
COPY davinci-zkvm/Plonky3-recursion/circuit-prover Plonky3-recursion/circuit-prover
COPY davinci-zkvm/Plonky3-recursion/recursion Plonky3-recursion/recursion
COPY davinci-zkvm/Plonky3-recursion/poseidon2-circuit-air Plonky3-recursion/poseidon2-circuit-air
COPY davinci-zkvm/Plonky3-recursion/test-utils Plonky3-recursion/test-utils

# -- Copy workspace manifests --
COPY davinci-zkvm/Cargo.toml davinci-zkvm/Cargo.lock ./
COPY davinci-zkvm/input-gen/Cargo.toml input-gen/Cargo.toml
COPY davinci-zkvm/service/Cargo.toml service/Cargo.toml
COPY davinci-zkvm/recursion-aggregator/Cargo.toml recursion-aggregator/Cargo.toml

# Create stub sources to cache dependencies
RUN mkdir -p input-gen/src service/src recursion-aggregator/src && \
    echo 'pub fn placeholder() {}' > input-gen/src/lib.rs && \
    echo 'fn main() {}' > service/src/main.rs && \
    echo 'pub fn placeholder() {}' > recursion-aggregator/src/lib.rs

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release --features ballot-aggregation \
    -p davinci-zkvm-service -p davinci-zkvm-input-gen 2>&1 || true

RUN rm -rf input-gen/src service/src recursion-aggregator/src

COPY davinci-zkvm/input-gen/src input-gen/src
COPY davinci-zkvm/service/src service/src
COPY davinci-zkvm/recursion-aggregator/src recursion-aggregator/src

# Invalidate fingerprints so cargo rebuilds the real crates
RUN find target/release/.fingerprint -maxdepth 1 -name "davinci*" -exec rm -rf {} + 2>/dev/null || true

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cargo build --release --features ballot-aggregation \
    -p davinci-zkvm-service -p davinci-zkvm-input-gen

# ── Stage 3: Build the zkVM circuit ELF from source ──────────────────────────
FROM cuda-builder AS circuit-builder

WORKDIR /build

COPY Cargo.toml Cargo.lock build.rs ./
COPY src src
COPY vendor vendor
COPY davinci-zkvm/input-gen/Cargo.toml davinci-zkvm/input-gen/Cargo.toml
COPY davinci-zkvm/input-gen/src davinci-zkvm/input-gen/src
COPY davinci-zkvm/circuit/Cargo.toml davinci-zkvm/circuit/Cargo.toml
COPY davinci-zkvm/circuit/Cargo.lock davinci-zkvm/circuit/Cargo.lock
COPY davinci-zkvm/circuit/src davinci-zkvm/circuit/src

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    cd /build/davinci-zkvm/circuit && /src/zisk/target/release/cargo-zisk build --release

# ── Stage 4: CUDA runtime image ───────────────────────────────────────────────
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    make \
    gcc \
    g++ \
    binutils \
    libc6-dev \
    libssl3 \
    libgomp1 \
    libsodium23 \
    libopenmpi3 \
    openmpi-bin \
    openmpi-common \
    libgmp-dev \
    libomp5-18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create symlink for libzisk_witness.so at the default path cargo-zisk expects
RUN mkdir -p /root/.zisk/bin && \
    ln -s /usr/local/lib/libzisk_witness.so /root/.zisk/bin/libzisk_witness.so

# Copy GPU-enabled cargo-zisk
COPY --from=cuda-builder /src/zisk/target/release/cargo-zisk /usr/local/bin/cargo-zisk
COPY --from=cuda-builder /src/zisk/emulator-asm /root/.zisk/zisk/emulator-asm
COPY --from=cuda-builder /src/zisk/lib-c /root/.zisk/zisk/lib-c
COPY --from=cuda-builder /src/zisk/target/release/libziskclib.a /root/.zisk/bin/libziskclib.a
# libzisk_witness.so output location varies across cargo/zisk builds.
RUN --mount=from=cuda-builder,source=/src/zisk/target,target=/zisk-target \
    bash -c 'lib="$(find /zisk-target -name libzisk_witness.so -print -quit)"; \
             if [ -n "$lib" ]; then cp "$lib" /usr/local/lib/libzisk_witness.so; fi'

# Copy service binary
COPY --from=service-builder /build/davinci-zkvm/target/release/davinci-zkvm /app/davinci-zkvm

# Copy fresh circuit ELF built from the current sources
COPY --from=circuit-builder \
    /build/davinci-zkvm/circuit/target/riscv64ima-zisk-zkvm-elf/release/davinci-zkvm-circuit \
    /app/circuit.elf

ENV LISTEN_ADDR=0.0.0.0:8080
ENV PROVING_KEY_PATH=/proving-key
ENV CIRCUIT_ELF_PATH=/app/circuit.elf
ENV CARGO_ZISK_BIN=/usr/local/bin/cargo-zisk
ENV PROOF_OUTPUT_DIR=/proofs
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
# Restrict OpenMPI to loopback/shared-memory transport only — prevents any
# CUDA-aware MPI transport from touching the CUDA context and destroying it.
ENV OMPI_MCA_btl=vader,self
ENV OMPI_MCA_pml=ob1
ENV OMPI_MCA_opal_cuda_support=0
ENV OMPI_MCA_btl_smcuda_use_cuda_ipc=0
# Allow OpenMPI to run as root (required in Docker containers)
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

COPY davinci-zkvm/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
