# Docker Compose environment — copy to .env and adjust as needed.
#
# Profile selects which service to start:
#   cuda  — NVIDIA GPU prover (requires nvidia-container-toolkit)
#   cpu   — API-only, no proof generation (ZisK v0.17.0 GPU proving keys
#           are incompatible with CPU provers)
COMPOSE_PROFILES=cuda

# Host path to the ZisK proving key directory (default: ~/.zisk/provingKey).
# PROVING_KEY_PATH=/path/to/provingKey

# Host path to the ZisK PLONK/zkSNARK proving key directory
# (default: ~/.zisk/provingKeySnark). Required when GENERATE_FINAL_SNARK=true.
# PROVING_KEY_PLONK_PATH=/path/to/provingKeySnark

# Generate a final PLONK/zkSNARK proof. Disabled by default because ZisK v0.17.0
# currently fails in recursive witness generation for this circuit/key setup;
# CUDA E2E tests only require successful job completion and tally verification.
# GENERATE_FINAL_SNARK=false

# Ask cargo-zisk to verify generated proofs. Disabled by default for the CUDA E2E
# compatibility mode above; enable for strict proof-validity runs.
# VERIFY_ZISK_PROOFS=false

# Host port to expose the HTTP API on (default: 8080).
# LISTEN_PORT=8080

# Maximum number of jobs in the prove queue (default: 100).
# MAX_QUEUE_SIZE=100

# Optional MPI concurrency for cargo-zisk prove:
# - Keep defaults for single-process proving.
# - For concurrent proving, set ZISK_MPI_PROCS > 1 and tune threads per process.
# - CPU memory and (for CUDA) GPU memory requirements increase with process count.
# ZISK_MPI_PROCS=1
# ZISK_MPI_THREADS=0
# ZISK_MPI_BIND_TO=none
