# Docker Compose environment — copy to .env and adjust as needed.
#
# The davinci-zkvm service runs on NVIDIA GPU only (driver 570+ and
# nvidia-container-toolkit on the host; no CUDA toolkit needed — the
# prebuilt cargo-zisk-gpu is statically linked against the CUDA runtime).
# It always produces a PLONK SNARK ready for on-chain verification.

# Default compose profile. `make` targets pass the right profile per
# command, so this is only consulted if you call `docker compose` directly.
COMPOSE_PROFILES=cuda

# ZisK version. Keep ZISK_TAG and ZISK_VERSION in sync — the tag is the
# upstream git tag (with leading 'v'), the version is the bare semver
# ziskup passes on its --version flag.
# ZISK_TAG=v1.3.0-alpha
# ZISK_VERSION=1.3.0-alpha

# Where to install the proving keys on the host. The `key-installer`
# container writes here; the prover container mounts subdirectories of it.
# ZISK_KEYS_DIR=./zisk-keys

# Host port to expose the HTTP API on.
# LISTEN_PORT=8080

# Host address the API binds to (default all interfaces), e.g. a private
# network address.
# BIND_ADDR=0.0.0.0

# Run the published image instead of building one (then `docker compose pull`).
# `latest` is the last release; add `--profile watchtower` to follow it.
# DAVINCI_ZKVM_IMAGE=ghcr.io/vocdoni/davinci-zkvm:latest

# Maximum number of queued prove jobs.
# MAX_QUEUE_SIZE=100

# MPI concurrency for `cargo-zisk prove`.
# Keep the defaults for single-process proving; increase for parallel
# proving on multi-GPU hosts. Memory grows roughly per process.
# ZISK_MPI_PROCS=1
# ZISK_MPI_THREADS=0
# ZISK_MPI_BIND_TO=none

# Keep per-job input.bin (the private witness) and serve it on
# GET /jobs/{id}/inputs. Development only.
# DAVINCI_KEEP_INPUTS=0
